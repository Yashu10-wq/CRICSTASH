# Neon PostgreSQL Database Configuration (Option A: Direct DB_URI from Neon console)
# Example: postgresql://neondb_owner:npg_placeholder_secret@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_URI=postgresql://your_user:your_password@ep-your-endpoint.region.aws.neon.tech/neondb?sslmode=require

# Neon PostgreSQL Database Configuration (Option B: Standard Spring Datasource properties)
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-your-endpoint.region.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=your_neon_username
SPRING_DATASOURCE_PASSWORD=your_neon_password

# Server Port
PORT=8080

# JWT Security Configuration
JWT_SECRET=CricketScoreSuperSecretKeyWithMinimum256BitsLengthForHmacSha256Security123456
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
